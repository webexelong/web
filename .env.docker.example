# ==============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG DOCKER COMPOSE CHO WEBCAFE
# Sao chép file này thành .env hoặc .env.docker trước khi chạy docker compose
# ==============================================================================

# 1. Mật khẩu tài khoản 'sa' của SQL Server (Tối thiểu 8 ký tự gồm chữ hoa, thường, số, ký tự đặc biệt)
MSSQL_SA_PASSWORD=WebCafe@Secured2026!

# 2. Cổng Web chạy ngoài máy chủ (Mặc định 80 cho HTTP, 443 cho HTTPS nếu sau này gắn SSL)
PORT=80

# 3. Khóa bí mật JWT (Bắt buộc tối thiểu 64 ký tựi ở môi trường Production)
JWT_SECRET_KEY=WebCafeProductionSecureKey2026_MustBeAtLeast64CharactersLong_VeryStrongSecretKey!

# 4. Địa chỉ Web hoặc Tên miền sau khi deploy (Dùng cho CORS và PayOS callback)
# Khi chạy thử trên máy tính cá nhân: http://localhost
# Khi đưa lên AWS với IP: http://13.250.xx.xx
# Khi đã gắn tên miền: https://webcafe.site
FRONTEND_PUBLIC_URL=http://localhost
FRONTEND_DOMAIN_ORIGIN=http://localhost

# 5. Thông tin cổng thanh toán PayOS (Nếu sử dụng thanh toán quét QR tự động)
PAYOS_CLIENT_ID=YOUR_PAYOS_CLIENT_ID
PAYOS_API_KEY=YOUR_PAYOS_API_KEY
PAYOS_CHECKSUM_KEY=YOUR_PAYOS_CHECKSUM_KEY

# 6. Google Analytics 4 (Tùy chọn)
VITE_GA_ID=G-NJFPHGJW2P

# 7. Cấu hình Email SMTP (Xác minh tài khoản khi đăng ký dùng thử 14 ngày)
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=webaismartserve@gmail.com
EMAIL_PASSWORD=your_16_character_app_password
EMAIL_FROM=webaismartserve@gmail.com
EMAIL_ENABLE_SSL=true

